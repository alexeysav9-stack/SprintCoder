# ==============================================================================
# SprintCoder Configuration (.env)
# ==============================================================================

# Security
# Generate a strong key for production (e.g. python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production

# Set to False in production!
DEBUG=False

# Allowed domain names or server IPs (comma-separated). Example: sprintcoder.dev,www.sprintcoder.dev,192.168.1.100
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# CSRF Trusted Origins for HTTPS production (comma-separated, include protocol). Example: https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Database Configuration (Option A: Connection URL - e.g. Neon, Supabase, Railway, Render)
# DATABASE_URL=postgresql://user:password@host:5432/sprintcoder?sslmode=require

# Database Configuration (Option B: Individual parameters - standard PostgreSQL / Docker)
DB_NAME=sprintcoder
DB_USER=sprintcoder
DB_PASSWORD=sprintcoder_secure_password
DB_HOST=localhost
DB_PORT=5432

# Production HTTPS / Security options (set to True when using HTTPS domain with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Optional: GitHub Personal Access Token for snippet import & replenishment
GITHUB_TOKEN=your-github-personal-access-token
