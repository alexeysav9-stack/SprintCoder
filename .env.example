# ==============================================================================
# SprintCoder Configuration (.env)
# ==============================================================================

# Security
# Generate a secret key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-very-long-random-secret-key-in-production

# Set to False in production!
DEBUG=False

# Allowed domain names or server IPs (comma-separated). Example: sprintcoder.ru,www.sprintcoder.ru,185.xxx.xxx.xxx
ALLOWED_HOSTS=127.0.0.1,localhost,yourdomain.com

# CSRF Trusted Origins for HTTPS production (comma-separated, include protocol). Example: https://yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Time Zone (e.g. Europe/Istanbul, UTC, America/New_York)
TIME_ZONE=Europe/Istanbul

# Database Configuration (Option A: Connection URL - e.g. Neon, Supabase, Railway, Render)
# DATABASE_URL=postgresql://user:password@host:5432/sprintcoder?sslmode=require

# Database Configuration (Option B: Individual parameters - standard PostgreSQL / Docker)
DB_NAME=sprintcoder
DB_USER=sprintcoder
DB_PASSWORD=sprintcoder_secure_password
DB_HOST=localhost
DB_PORT=5432

# Production HTTPS / Security options (set to True when using HTTPS domain with SSL)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# ==============================================================================
# Social Authentication (OAuth 2.0)
# ==============================================================================

# GitHub OAuth App (Create at: https://github.com/settings/developers -> OAuth Apps)
# Authorization callback URL: https://yourdomain.com/accounts/oauth/github/callback/
# For local development: http://127.0.0.1:8000/accounts/oauth/github/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth 2.0 Client (Create at: https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: https://yourdomain.com/accounts/oauth/google/callback/
# For local development: http://127.0.0.1:8000/accounts/oauth/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# GitHub Snippet Import Token (Optional)
# ==============================================================================
# Used to fetch real code from public GitHub repositories for typing practice
GITHUB_TOKEN=
