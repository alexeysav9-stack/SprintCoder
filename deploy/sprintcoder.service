[Unit]
Description=SprintCoder Gunicorn Application Server
After=network.target postgresql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/sprintcoder
EnvironmentFile=/var/www/sprintcoder/.env
ExecStart=/var/www/sprintcoder/venv/bin/gunicorn \
    --workers 3 \
    --timeout 120 \
    --bind 127.0.0.1:8000 \
    sprintcoder.wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
